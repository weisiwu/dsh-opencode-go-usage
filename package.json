{
  "name": "dsh-opencode-go-usage",
  "version": "0.1.0",
  "description": "DSH Web UI OpenCode Go 额度插件：输入框下方常驻显示当前会话路由所属账号的 5 小时/周/月剩余量与状态",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "clean:artifacts": "node scripts/clean-artifacts.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "npm run typecheck:src && npm run typecheck:tests",
    "typecheck:src": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "node node_modules/typescript/bin/tsc -p tsconfig.test.json --noEmit",
    "test": "NODE_ENV=test node node_modules/vitest/vitest.mjs run tests",
    "verify:artifacts": "node scripts/verify-artifacts.mjs lib",
    "prepack": "npm run clean && npm run typecheck && npm test && npm run build && npm run verify:artifacts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1",
    "@deepseek-ai/dsh-client-connection": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.2",
    "@types/node": "22.20.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
